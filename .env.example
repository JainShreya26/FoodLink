# Powers donation ingestion and the inventory chat.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — swap the map tiles for Mapbox or self-hosted Protomaps.
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Optional — driver check-in texts.
# Messages are LOGGED, not sent, unless this is exactly "1" AND the Twilio
# credentials below are present AND the delivery records driver consent.
# FOODLINK_SMS_ENABLED=0
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
